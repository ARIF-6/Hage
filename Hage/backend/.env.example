# ─────────────────────────────────────────────────────────────
#  Hage Backend — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/Hage

# ── Authentication ────────────────────────────────────────────
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── Admin Credentials (fallback when DB is empty) ─────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_me_secure_password

# ── Google OAuth (optional) ───────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── SMTP / Email (for sending emails to users) ────────────────
# Gmail: enable 2FA and create an App Password at:
# https://myaccount.google.com → Security → App Passwords
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ── URLs ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── NOWPayments (USDT crypto payments) ───────────────────────
# Get API key: https://nowpayments.io → Account → API Keys
# Get IPN secret: https://nowpayments.io → Settings → IPN
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SANDBOX=true

# ── AI Support (OpenAI) ───────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SUPPORT_ENABLED=true
AI_SUPPORT_MODE=combined
AI_SUPPORT_MAX_OUTPUT_TOKENS=800
AI_SUPPORT_MAX_MESSAGE_LENGTH=2000
AI_SUPPORT_RATE_LIMIT=30
